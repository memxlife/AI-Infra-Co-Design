{#- One GEMM program exposing every decision TileLang can express (tiers 1-3 of agentic/decide/registry):
    tile (block_M, block_N, block_K), pipeline (num_stages, prefetch), threads, traversal (swizzle), warp split
    (warp_policy), copy width (vec_width), copy path (copy_path: tma | cpasync), the producer warp group (warp_spec),
    shared-memory layout (smem_layout), the C store (c_store: direct | staged through shared memory with stmatrix and a
    TMA store) and split-K (split_k: 1 returns C in fp16; >1 adds fp32 partial products into C with atomics). -#}
import tilelang
import tilelang.language as T
{% if warp_policy %}from tilelang.tileop.base import GemmWarpPolicy
{% endif %}{% if smem_layout == "swizzled" %}from tilelang.layout import make_swizzled_layout
{% endif %}{% if copy_path == "cpasync" %}from tilelang.cuda.language import copy as cuda_copy
{% endif %}

@tilelang.jit{% if not warp_spec %}(pass_configs={"tl.disable_warp_specialized": True}){% endif %}
def matmul(A, B{% if split_k > 1 %}, C{% endif %}, dtype=T.float16, accum_dtype=T.float32):
    M, N, K = T.const("M, N, K")

    A: T.Tensor((M, K), dtype)
    B: T.Tensor((K, N), dtype)
{% if split_k > 1 %}    C: T.Tensor((M, N), accum_dtype)
{% else %}    C = T.empty((M, N), dtype)
{% endif %}
    with T.Kernel(T.ceildiv(N, {{ block_N }}), T.ceildiv(M, {{ block_M }}){% if split_k > 1 %}, {{ split_k }}{% endif %}, threads={{ threads }}) as ({% if split_k > 1 %}bx, by, bz{% else %}bx, by{% endif %}):
        A_shared = T.alloc_shared(({{ block_M }}, {{ block_K }}), dtype)
        B_shared = T.alloc_shared(({{ block_K }}, {{ block_N }}), dtype)
        C_local = T.alloc_fragment(({{ block_M }}, {{ block_N }}), accum_dtype)
{% if c_store == "staged" and split_k == 1 %}        C_shared = T.alloc_shared(({{ block_M }}, {{ block_N }}), dtype)
{% endif %}{% if smem_layout == "swizzled" %}        T.annotate_layout({A_shared: make_swizzled_layout(A_shared), B_shared: make_swizzled_layout(B_shared)})
{% endif %}{% if swizzle %}        T.use_swizzle(panel_size={{ swizzle }})
{% endif %}        T.clear(C_local)
{% set kpart = ("K // " ~ split_k) if split_k > 1 else "K" %}{% set k0 = ("bz * (K // " ~ split_k ~ ") + ") if split_k > 1 else "" %}{% if prefetch %}        for k in T.Pipelined(T.ceildiv({{ kpart }}, {{ block_K }}), num_stages={{ num_stages }}, order=[0, 1, 2], stage=[0, 0, {{ prefetch }}]):
{% else %}        for k in T.Pipelined(T.ceildiv({{ kpart }}, {{ block_K }}), num_stages={{ num_stages }}):
{% endif %}{% set cp = "cuda_copy" if copy_path == "cpasync" else "T.copy" %}{% set extra = (", coalesced_width=" ~ vec_width if vec_width else "") ~ (", disable_tma=True" if copy_path == "cpasync" else "") %}            {{ cp }}(A[by * {{ block_M }}, {{ k0 }}k * {{ block_K }}], A_shared{{ extra }})
            {{ cp }}(B[{{ k0 }}k * {{ block_K }}, bx * {{ block_N }}], B_shared{{ extra }})
{% if warp_policy %}            T.gemm(A_shared, B_shared, C_local, policy=GemmWarpPolicy.{{ {1: "FullRow", 2: "FullCol"}[warp_policy] }})
{% else %}            T.gemm(A_shared, B_shared, C_local)
{% endif %}
{% if split_k > 1 %}        T.atomic_add(C[by * {{ block_M }}, bx * {{ block_N }}], C_local)
{% elif c_store == "staged" %}        T.copy(C_local, C_shared)
        T.copy(C_shared, C[by * {{ block_M }}, bx * {{ block_N }}])
{% else %}        T.copy(C_local, C[by * {{ block_M }}, bx * {{ block_N }}])
{% endif %}{% if split_k == 1 %}
    return C
{% endif %}
