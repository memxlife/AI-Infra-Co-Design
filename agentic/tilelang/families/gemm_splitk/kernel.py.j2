import tilelang
import tilelang.language as T


@tilelang.jit
def matmul(A, B, C{{ params }}, dtype=T.float16, accum_dtype=T.float32):
    # TileLang's examples/gemm_splitk/example_tilelang_gemm_splitk.py with the holes of gemm_basic plus split_k.
    # C is FP32, zeroed by the caller, and every z-block adds its part of K into it with atomics.
    M, N, K = T.const("M, N, K")
    splitK = K // {{ split_k }}

    A: T.Tensor((M, K), dtype)
    B: T.Tensor((K, N), dtype)
    C: T.Tensor((M, N), accum_dtype)

    with T.Kernel(T.ceildiv(N, {{ block_N }}), T.ceildiv(M, {{ block_M }}), {{ split_k }}, threads={{ threads }}) as (bx, by, bz):
        A_shared = T.alloc_shared(({{ block_M }}, {{ block_K }}), dtype)
        B_shared = T.alloc_shared(({{ block_K }}, {{ block_N }}), dtype)
        C_local = T.alloc_fragment(({{ block_M }}, {{ block_N }}), accum_dtype)

{% if swizzle is string %}        T.use_swizzle(panel_size={{ swizzle }}, enable={{ swizzle }} > 0)
{% elif swizzle %}        T.use_swizzle(panel_size={{ swizzle }})
{% endif %}        T.clear(C_local)
        for ko in T.Pipelined(T.ceildiv(splitK, {{ block_K }}), num_stages={{ num_stages }}):
            T.copy(A[by * {{ block_M }}, bz * splitK + ko * {{ block_K }}], A_shared)
            T.copy(B[bz * splitK + ko * {{ block_K }}, bx * {{ block_N }}], B_shared)
            T.gemm(A_shared, B_shared, C_local)

        T.atomic_add(C[by * {{ block_M }}, bx * {{ block_N }}], C_local)
